# Copy this file to ".env" and replace the placeholder values.
# NEVER commit the real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True only when serving over HTTPS (and DJANGO_DEBUG=False)
DJANGO_HTTPS=False

DB_NAME=healthcare_db
DB_USER=healthcare_user
DB_PASSWORD=replace-me-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes (optional)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
